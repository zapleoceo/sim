# SIM v2 — пример окружения (docs/deploy.md). В проде compose задаёт SIM_ENV, SIM_DATABASE_URL,
# SIM_MEDIA_DIR, SIM_STATIC_DIR сам; в infra/.env остаются только секреты и адреса ниже.
POSTGRES_PASSWORD=
SIM_PUBLIC_URL=https://sim.zapleo.com
SIM_COOKIE_SECURE=true
# Fernet-ключ (или список через запятую, первый шифрует) — шифрует сессию Telegram в channel.
SIM_SECRET_KEY=
SIM_BROKER_URL=https://aib.zapleo.com
SIM_BROKER_PROJECT_KEY=
SIM_TG_LOGIN_BOT_TOKEN=
SIM_TG_LOGIN_BOT_USERNAME=
SIM_SUPERADMIN_TELEGRAM_IDS=
SIM_CALLS_ENABLED=true
