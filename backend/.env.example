# SIM v2 — пример окружения (docs/deploy.md). В проде compose задаёт SIM_ENV, SIM_DATABASE_URL,
# SIM_MEDIA_DIR, SIM_STATIC_DIR сам; в infra/.env остаются только секреты и адреса ниже.
POSTGRES_PASSWORD=
SIM_PUBLIC_URL=https://sim.zapleo.com
SIM_COOKIE_SECURE=true
# Fernet-ключ (или список через запятую, первый шифрует) — шифрует сессию Telegram в channel.
SIM_SECRET_KEY=
SIM_BROKER_URL=https://aib.zapleo.com
SIM_BROKER_PROJECT_KEY=
SIM_TG_LOGIN_BOT_TOKEN=
SIM_TG_LOGIN_BOT_USERNAME=
SIM_SUPERADMIN_TELEGRAM_IDS=
SIM_CALLS_ENABLED=true
# Instagram Direct (docs/channels.md, «Темп опроса»): опрос в разговоре / обычный / в тишине и ночью,
# лимиты отправки на аккаунт, прокси по умолчанию
# для аккаунтов без своего (обязателен: вход с серверного IP Instagram банит).
SIM_IG_POLL_ACTIVE_S=45
SIM_IG_POLL_INTERVAL_S=120
SIM_IG_POLL_QUIET_S=300
SIM_IG_HOURLY_CAP=60
SIM_IG_DAILY_CAP=400
SIM_IG_DEFAULT_PROXY=
# WhatsApp (docs/channels.md, docs/deploy.md «WhatsApp»): только с профилем compose `whatsapp`.
# Пусто = сервиса нет, дашборд пишет «Сервис WhatsApp не запущен на сервере».
# COMPOSE_PROFILES=whatsapp
# EVOLUTION_API_KEY=<длинный случайный ключ>
# SIM_EVOLUTION_URL=http://evolution:8080
# SIM_EVOLUTION_API_KEY=<тот же ключ>
# SIM_EVOLUTION_WEBHOOK_BASE=http://api:8000/api
