# Copy to .env (never commit .env). All variables use the SIM_ prefix.

SIM_ENV=dev                                   # dev | test | prod
SIM_DATABASE_URL=sqlite+aiosqlite:///./sim.db # prod: postgresql+asyncpg://sim:***@db:5432/sim
SIM_PUBLIC_URL=http://localhost:8000          # used for Telegram webhook URLs

# Fernet key (or comma-separated list: first encrypts, all decrypt) for channel secrets.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIM_SECRET_KEY=
SIM_SESSION_TTL_H=72
SIM_COOKIE_SECURE=false                       # true behind HTTPS (prod)

# AIbroker (project "sim")
SIM_BROKER_URL=https://aib.zapleo.com
SIM_BROKER_PROJECT_KEY=
SIM_BROKER_POLL_BUDGET_S=180
SIM_BROKER_SUBSCRIPTION_BUDGET_S=600

# WhatsApp (Evolution API)
SIM_EVOLUTION_URL=http://evolution:8080
SIM_EVOLUTION_API_KEY=
SIM_EVOLUTION_WEBHOOK_BASE=http://api:8000

# Instagram
SIM_IG_PROXY=
SIM_IG_POLL_INTERVAL_S=120

# HMAC secret shared with the partner for /hooks/partner
SIM_PARTNER_WEBHOOK_SECRET=

# First owner, created by `python -m sim.seed` (or at API start) when there are no admins
SIM_BOOTSTRAP_OWNER_USERNAME=
SIM_BOOTSTRAP_OWNER_PASSWORD=

SIM_REPLY_DEBOUNCE_S=8
SIM_WORKER_TICK_S=2

# Built Angular app and downloaded media (prod: /app/static, /app/media)
SIM_STATIC_DIR=../frontend/dist/sim/browser
SIM_MEDIA_DIR=./media
